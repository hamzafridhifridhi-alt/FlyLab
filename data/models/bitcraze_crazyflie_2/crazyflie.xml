<mujoco model="bitcraze_crazyflie_2">
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
  <option timestep="0.001" gravity="0 0 -9.81"/>

  <visual>
    <global offwidth="1920" offheight="1080"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <material name="grid" texture="grid" texrepeat="10 10" texuniform="true" reflectance=".2"/>
    <material name="body_mat" rgba="0.1 0.1 0.1 1"/>
    <material name="arm_mat" rgba="0.7 0.7 0.7 1"/>
    <material name="prop_cw" rgba="0.1 0.8 0.3 0.85"/>
    <material name="prop_ccw" rgba="0.9 0.2 0.1 0.85"/>
    <material name="sensor_mat" rgba="0.0 0.8 1.0 1"/>
  </asset>

  <worldbody>
    <geom name="floor" size="20 20 0.01" type="plane" material="grid"/>
    <light directional="true" diffuse=".8 .8 .8" specular=".2 .2 .2" pos="0 0 5" dir="0 0 -1"/>

    <body name="crazyflie" pos="0 0 0.5">
      <freejoint name="root"/>
      <camera name="trackcam" pos="-0.5 0 0.3" xyaxes="0 -1 0 0.5 0 0.8" mode="trackcom"/>
      <camera name="fpvcam" pos="0.03 0 0.01" xyaxes="0 -1 0 0 0 1"/>

      <!-- Core PCB Base (27g total drone mass) -->
      <geom name="core" type="box" size="0.015 0.015 0.005" mass="0.015" material="body_mat"/>
      <geom name="battery" type="box" size="0.012 0.008 0.004" pos="0 0 -0.006" mass="0.008" rgba="0.2 0.2 0.2 1"/>

      <!-- Bio-inspired VOC E-Nose / Plant Anomaly Sensor Module -->
      <geom name="cov_sensor" type="cylinder" size="0.004 0.003" pos="0.018 0 0.005" mass="0.001" material="sensor_mat"/>

      <!-- Arm 1: Front Right (+x, -y) -->
      <body name="arm1" pos="0.028 -0.028 0">
        <geom name="arm1_geom" type="cylinder" fromto="0 0 0 0.018 -0.018 0" size="0.0015" mass="0.0005" material="arm_mat"/>
        <body name="motor1" pos="0.018 -0.018 0">
          <geom name="motor1_geom" type="cylinder" size="0.004 0.007" mass="0.0008" rgba="0.3 0.3 0.3 1"/>
          <geom name="prop1_geom" type="cylinder" size="0.022 0.001" pos="0 0 0.007" mass="0.0002" material="prop_cw"/>
          <site name="thrust1" pos="0 0 0.007"/>
        </body>
      </body>

      <!-- Arm 2: Rear Right (-x, -y) -->
      <body name="arm2" pos="-0.028 -0.028 0">
        <geom name="arm2_geom" type="cylinder" fromto="0 0 0 -0.018 -0.018 0" size="0.0015" mass="0.0005" material="arm_mat"/>
        <body name="motor2" pos="-0.018 -0.018 0">
          <geom name="motor2_geom" type="cylinder" size="0.004 0.007" mass="0.0008" rgba="0.3 0.3 0.3 1"/>
          <geom name="prop2_geom" type="cylinder" size="0.022 0.001" pos="0 0 0.007" mass="0.0002" material="prop_ccw"/>
          <site name="thrust2" pos="0 0 0.007"/>
        </body>
      </body>

      <!-- Arm 3: Rear Left (-x, +y) -->
      <body name="arm3" pos="-0.028 0.028 0">
        <geom name="arm3_geom" type="cylinder" fromto="0 0 0 -0.018 0.018 0" size="0.0015" mass="0.0005" material="arm_mat"/>
        <body name="motor3" pos="-0.018 0.018 0">
          <geom name="motor3_geom" type="cylinder" size="0.004 0.007" mass="0.0008" rgba="0.3 0.3 0.3 1"/>
          <geom name="prop3_geom" type="cylinder" size="0.022 0.001" pos="0 0 0.007" mass="0.0002" material="prop_cw"/>
          <site name="thrust3" pos="0 0 0.007"/>
        </body>
      </body>

      <!-- Arm 4: Front Left (+x, +y) -->
      <body name="arm4" pos="0.028 0.028 0">
        <geom name="arm4_geom" type="cylinder" fromto="0 0 0 0.018 0.018 0" size="0.0015" mass="0.0005" material="arm_mat"/>
        <body name="motor4" pos="0.018 0.018 0">
          <geom name="motor4_geom" type="cylinder" size="0.004 0.007" mass="0.0008" rgba="0.3 0.3 0.3 1"/>
          <geom name="prop4_geom" type="cylinder" size="0.022 0.001" pos="0 0 0.007" mass="0.0002" material="prop_ccw"/>
          <site name="thrust4" pos="0 0 0.007"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="m1" gear="0 0 1 0 0 0.005" site="thrust1"/>
    <motor name="m2" gear="0 0 1 0 0 -0.005" site="thrust2"/>
    <motor name="m3" gear="0 0 1 0 0 0.005" site="thrust3"/>
    <motor name="m4" gear="0 0 1 0 0 -0.005" site="thrust4"/>
  </actuator>
</mujoco>
